# Recall — example environment configuration.
#
# Copy this file to `.env` and fill in real values locally.
# NEVER commit a populated `.env` — only this `.env.example` with placeholders.

# ---------------------------------------------------------------------------
# CockroachDB Cloud
# ---------------------------------------------------------------------------
# Full SQL connection string for the Recall cluster. Obtain with:
#   ccloud cluster connection-string <cluster-name> --sql-user <user> -o json
# The placeholder below is a well-formed but non-functional example.
CRDB_CONNECTION_STRING=postgresql://recall_app:REPLACE_ME@example-cluster.aws-us-east-1.cockroachlabs.cloud:26257/recall?sslmode=verify-full

# ---------------------------------------------------------------------------
# AWS / Bedrock
# ---------------------------------------------------------------------------
AWS_REGION=us-east-1

# Bedrock model IDs. These are the models the kernel will call in later phases.
BEDROCK_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
BEDROCK_REASONING_MODEL=anthropic.claude-sonnet-4-5-v1:0

# ---------------------------------------------------------------------------
# Recall runtime behaviour
# ---------------------------------------------------------------------------
# Identity stamped onto every audit_log row written by this process.
RECALL_ACTOR_ID=local-dev

# When true, the kernel refuses all write/fork/commit operations and only
# permits reads. Accepts: true/false, 1/0, yes/no (case-insensitive).
RECALL_READ_ONLY=false
